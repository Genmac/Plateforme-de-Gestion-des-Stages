{
  "name": "gestion-stages",
  "version": "1.0.0",
  "description": "Plateforme de gestion de stage",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seeds/seed.js",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "test": "node --test --test-force-exit \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "swagger-jsdoc": {
      "glob": "^14.0.6"
    },
    "nodemon": {
      "minimatch": "^11.0.8"
    }
  }
}
