{
  "name": "gestion-stages",
  "version": "1.0.0",
  "description": "Plateforme de gestion de stage",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seeds/seed.js",
